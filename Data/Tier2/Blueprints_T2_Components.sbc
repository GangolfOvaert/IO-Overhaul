<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Blueprints>

    <!-- ============================= -->
    <!-- TIER 2 COMPONENT CRAFTING     -->
    <!-- Advanced multi-material parts -->
    <!-- ============================= -->

    <!-- Glass: 2 Silicium Ingot -> 1 Glass -->
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>T2_Glass</SubtypeId>
      </Id>
      <DisplayName>Glass</DisplayName>
      <Icon>Textures\GUI\Icons\component\display_component.dds</Icon>
      <Icon>Icons\t2.dds</Icon>
      <Prerequisites>
        <Item Amount="2" TypeId="Ingot" SubtypeId="Silicium" />
      </Prerequisites>
      <Result Amount="1" TypeId="Component" SubtypeId="Glass" />
      <BaseProductionTimeInSeconds>10</BaseProductionTimeInSeconds>
      <IsPrimary>true</IsPrimary>
    </Blueprint>

    <!-- Silicium Wafer: 1 Silicium Ingot -> 2 Silicium Wafers -->
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>T2_SiliciumWafer</SubtypeId>
      </Id>
      <DisplayName>Silicium Wafer</DisplayName>
      <Icon>Textures\GUI\Icons\component\computer_component.dds</Icon>
      <Icon>Icons\t2.dds</Icon>
      <Prerequisites>
        <Item Amount="1" TypeId="Ingot" SubtypeId="Silicium" />
      </Prerequisites>
      <Result Amount="2" TypeId="Component" SubtypeId="SiliciumWafer" />
      <BaseProductionTimeInSeconds>8</BaseProductionTimeInSeconds>
      <IsPrimary>true</IsPrimary>
    </Blueprint>

    <!-- Carbon Block: 2 Carbon Ingot -> 1 Carbon Block -->
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>T2_CarbonBlock</SubtypeId>
