      <Result Amount="1" TypeId="Component" SubtypeId="CarbonBlock" />
      <BaseProductionTimeInSeconds>10</BaseProductionTimeInSeconds>
      <IsPrimary>true</IsPrimary>
    </Blueprint>

    <!-- Computer Chip: 1 Silicium Wafer + 1 Carbon Block + 1 CopperWire -> 1 Computer Chip -->
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>T2_ComputerChip</SubtypeId>
      </Id>
      <DisplayName>Computer Chip</DisplayName>
      <Icon>Textures\GUI\Icons\component\computer_component.dds</Icon>
      <Icon>Icons\t2.dds</Icon>
      <Prerequisites>
        <Item Amount="1" TypeId="Component" SubtypeId="SiliciumWafer" />
        <Item Amount="1" TypeId="Component" SubtypeId="CarbonBlock" />
        <Item Amount="1" TypeId="Component" SubtypeId="CopperWire" />
      </Prerequisites>
      <Result Amount="1" TypeId="Component" SubtypeId="ComputerChip" />
      <BaseProductionTimeInSeconds>15</BaseProductionTimeInSeconds>
      <IsPrimary>true</IsPrimary>
    </Blueprint>

    <!-- Simple PCB: 2 Silicium Ingot + 1 CopperWire -> 1 Simple PCB -->
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>T2_SimplePCB</SubtypeId>
      </Id>
      <DisplayName>Simple PCB</DisplayName>
      <Icon>Textures\GUI\Icons\component\computer_component.dds</Icon>
      <Icon>Icons\t2.dds</Icon>
      <Prerequisites>
        <Item Amount="2" TypeId="Ingot" SubtypeId="Silicium" />
        <Item Amount="1" TypeId="Component" SubtypeId="CopperWire" />
      </Prerequisites>
      <Result Amount="1" TypeId="Component" SubtypeId="SimplePCB" />
      <BaseProductionTimeInSeconds>12</BaseProductionTimeInSeconds>
      <IsPrimary>true</IsPrimary>
    </Blueprint>

    <!-- Copper Wire: 1 Copper Ingot -> 4 Copper Wires -->
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
