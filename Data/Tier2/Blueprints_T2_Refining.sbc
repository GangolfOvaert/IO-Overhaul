    <!-- ========== IMPURE ORES (25%) ========== -->

    <!-- Impure Cobalt Ore: 25% yield -->
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>T2_CobaltOreImpureToIngot</SubtypeId>
      </Id>
      <DisplayName>Cobalt Ingot (Impure)</DisplayName>
      <Icon>Textures\GUI\Icons\ingot\cobalt_ingot.dds</Icon>
      <Prerequisites>
        <Item Amount="1000" TypeId="Ore" SubtypeId="CobaltOreImpure" />
      </Prerequisites>
      <Result Amount="250" TypeId="Ingot" SubtypeId="Cobalt" />
      <BaseProductionTimeInSeconds>1500</BaseProductionTimeInSeconds>
      <IsPrimary>true</IsPrimary>
    </Blueprint>

