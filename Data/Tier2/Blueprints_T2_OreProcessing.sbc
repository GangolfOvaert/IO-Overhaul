<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Blueprints>

    <!-- ============================= -->
    <!-- T2 ROCK CRUSHER RECIPES       -->
    <!-- 1000 Impure ->                -->
    <!--   500 Crushed (target)        -->
    <!--   200 Crushed (same-tier T2)  -->
    <!--   100 Crushed (upper T3)      -->
    <!--   200 Gravel                  -->
    <!-- ============================= -->

    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>T2_CobaltOreImpureToCrushed</SubtypeId>
      </Id>
      <DisplayName>Crush Impure Cobalt Ore</DisplayName>
      <Icon>Icons\ore_Co_cobalt_pure.dds</Icon>
      <Icon>Icons\t2_cat.dds</Icon>
      <Prerequisites>
        <Item Amount="1000" TypeId="Ore" SubtypeId="CobaltOreImpure" />
      </Prerequisites>
      <Results>
        <Item Amount="500" TypeId="Ore" SubtypeId="CrushedCobalt" />
        <Item Amount="200" TypeId="Ore" SubtypeId="CrushedSilver" />
        <Item Amount="100" TypeId="Ore" SubtypeId="CrushedGold" />
        <Item Amount="200" TypeId="Ingot" SubtypeId="Stone" />
      </Results>
      <BaseProductionTimeInSeconds>1500</BaseProductionTimeInSeconds>
      <IsPrimary>true</IsPrimary>
    </Blueprint>

