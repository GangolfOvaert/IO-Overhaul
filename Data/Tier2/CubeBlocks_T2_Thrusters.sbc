<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <CubeBlocks>

        <!-- ============================================================ -->
        <!-- T2 ATMOSPHERIC THRUSTERS                                     -->
        <!-- Overrides vanilla + IO blocks with T2 component requirements -->
        <!-- Models/icons/performance unchanged; only build cost changed   -->
        <!-- ============================================================ -->

        <!-- ======================== -->
        <!-- LARGE GRID - REGULAR     -->
        <!-- ======================== -->

        <Definition xsi:type="MyObjectBuilder_ThrustDefinition">
            <Id>
                <TypeId>Thrust</TypeId>
                <SubtypeId>LargeBlockLargeAtmosphericThrust</SubtypeId>
            </Id>
            <DisplayName>Large Atmospheric Thruster</DisplayName>
            <Icon>Textures\GUI\Icons\Cubes\AtmosphericThrusterLargeLarge.dds</Icon>
            <Icon>Icons\t2.dds</Icon>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="3" y="3" z="5" />
            <ModelOffset x="0" y="0" z="0" />
            <Model>Models\Cubes\Large\AtmosphericThrusterLarge.mwm</Model>
            <Components>
                <Component Subtype="AluminumFrameL" Count="8" />
                <Component Subtype="CobaltPlate" Count="50" />
                <Component Subtype="IronBolt" Count="40" />
                <Component Subtype="IronPipe" Count="25" />
                <Component Subtype="AluminumFrameS" Count="25" />
                <Component Subtype="T2_ThrustComponent" Count="100" />
                <Component Subtype="CobaltPlate" Count="20" />
            </Components>
            <CriticalComponent Subtype="T2_ThrustComponent" Index="0" />
            <MountPoints>
                <MountPoint Side="Back" StartX="0" StartY="0" EndX="3" EndY="3" Default="true" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\AtmosphericThrusterLarge_Construction1.mwm" />
                <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\AtmosphericThrusterLarge_Construction2.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\AtmosphericThrusterLarge_Construction3.mwm" />
            </BuildProgressModels>
            <BlockPairName>LargeAtmosphericThrust</BlockPairName>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>80</BuildTimeSeconds>
            <ResourceSinkGroup>Thrust</ResourceSinkGroup>
            <ForceMagnitude>6480000</ForceMagnitude>
            <MaxPowerConsumption>16.8</MaxPowerConsumption>
            <MinPowerConsumption>0.000002</MinPowerConsumption>
            <ThrusterType>Atmospheric</ThrusterType>
            <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
            <DamagedSound>ParticleHeavyMech</DamagedSound>
            <PrimarySound>LrgShipLrgAtmospheric</PrimarySound>
            <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
            <DestroySound>WepSmallWarheadExpl</DestroySound>
            <PCU>25</PCU>
            <IsAirTight>false</IsAirTight>
        </Definition>

        <Definition xsi:type="MyObjectBuilder_ThrustDefinition">
            <Id>
                <TypeId>Thrust</TypeId>
                <SubtypeId>LargeBlockSmallAtmosphericThrust</SubtypeId>
