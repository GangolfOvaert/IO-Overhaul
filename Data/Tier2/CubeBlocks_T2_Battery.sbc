<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <CubeBlocks>

        <!-- ============================= -->
        <!-- T2 BATTERY - LARGE GRID       -->
        <!-- Rechargeable; overrides vanilla-->
        <!-- ============================= -->

        <Definition xsi:type="MyObjectBuilder_BatteryBlockDefinition">
            <Id>
                <TypeId>BatteryBlock</TypeId>
                <SubtypeId>LargeBlockBatteryBlock</SubtypeId>
            </Id>
            <DisplayName>Battery Block</DisplayName>
            <Icon>Textures\GUI\Icons\Cubes\battery.dds</Icon>
            <Icon>Icons\t2.dds</Icon>
            <Description>Rechargeable T2 battery. Stores and supplies electrical power.

Power Output: 12 MW
Capacity: 3 MWh</Description>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="1" y="1" z="1" />
            <ModelOffset x="0" y="0" z="0" />
            <Model>Models\Cubes\Large\BatteryLarge.mwm</Model>
            <Components>
                <Component Subtype="AluminumFrameL" Count="1" />
                <Component Subtype="CobaltPlate" Count="30" />
                <Component Subtype="AluminumPlate" Count="20" />
                <Component Subtype="CopperWire" Count="10" />
                <Component Subtype="T2_PowerCell" Count="80" />
                <Component Subtype="BasicComputer" Count="5" />
                <Component Subtype="CobaltPlate" Count="10" />
            </Components>
            <CriticalComponent Subtype="T2_PowerCell" Index="0" />
            <MountPoints>
                <MountPoint Side="Top" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
                <MountPoint Side="Front" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Left" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="1" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\BatteryLargeConstruction_1.mwm" />
                <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\BatteryLargeConstruction_2.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\BatteryLargeConstruction_3.mwm" />
            </BuildProgressModels>
            <BlockPairName>BatteryBlock</BlockPairName>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>60</BuildTimeSeconds>
            <ResourceSinkGroup>BatteryBlock</ResourceSinkGroup>
            <ResourceSourceGroup>Battery</ResourceSourceGroup>
            <MaxStoredPower>3</MaxStoredPower>
            <InitialStoredPowerRatio>0.3</InitialStoredPowerRatio>
            <MaxPowerOutput>12</MaxPowerOutput>
            <RequiredPowerInput>12</RequiredPowerInput>
            <AdaptibleInput>true</AdaptibleInput>
            <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
            <DamagedSound>ParticleHeavyMech</DamagedSound>
            <PrimarySound>BlockBattery</PrimarySound>
            <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
            <DestroySound>WepSmallWarheadExpl</DestroySound>
            <PCU>15</PCU>
            <IsAirTight>false</IsAirTight>
            <EmissiveColorPreset>Default</EmissiveColorPreset>
        </Definition>

        <!-- ============================= -->
        <!-- T2 BATTERY - SMALL GRID       -->
        <!-- ============================= -->

        <Definition xsi:type="MyObjectBuilder_BatteryBlockDefinition">
            <Id>
                <TypeId>BatteryBlock</TypeId>
                <SubtypeId>SmallBlockBatteryBlock</SubtypeId>
            </Id>
            <DisplayName>Battery Block</DisplayName>
            <Icon>Textures\GUI\Icons\Cubes\battery.dds</Icon>
            <Icon>Icons\t2.dds</Icon>
            <Description>Rechargeable T2 battery for small grid.

Power Output: 1 MW
Capacity: 0.2 MWh</Description>
            <CubeSize>Small</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="3" y="2" z="3" />
            <ModelOffset x="0" y="0" z="0" />
            <Model>Models\Cubes\Small\BatterySmall.mwm</Model>
            <Components>
                <Component Subtype="AluminumFrameS" Count="1" />
                <Component Subtype="CobaltPlate" Count="6" />
                <Component Subtype="AluminumPlate" Count="4" />
                <Component Subtype="CopperWire" Count="4" />
                <Component Subtype="T2_PowerCell" Count="20" />
                <Component Subtype="BasicComputer" Count="2" />
                <Component Subtype="CobaltPlate" Count="4" />
            </Components>
            <CriticalComponent Subtype="T2_PowerCell" Index="0" />
            <MountPoints>
                <MountPoint Side="Top" StartX="0" StartY="0" EndX="3" EndY="3" />
                <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="3" EndY="3" Default="true" />
                <MountPoint Side="Front" StartX="0" StartY="0" EndX="3" EndY="2" />
                <MountPoint Side="Back" StartX="0" StartY="0" EndX="3" EndY="2" />
                <MountPoint Side="Left" StartX="0" StartY="0" EndX="3" EndY="2" />
                <MountPoint Side="Right" StartX="0" StartY="0" EndX="3" EndY="2" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.5" File="Models\Cubes\Small\BatterySmallConstruction_1.mwm" />
                <Model BuildPercentUpperBound="1.0" File="Models\Cubes\Small\BatterySmallConstruction_2.mwm" />
            </BuildProgressModels>
            <BlockPairName>BatteryBlock</BlockPairName>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>25</BuildTimeSeconds>
            <ResourceSinkGroup>BatteryBlock</ResourceSinkGroup>
            <ResourceSourceGroup>Battery</ResourceSourceGroup>
            <MaxStoredPower>0.2</MaxStoredPower>
            <InitialStoredPowerRatio>0.3</InitialStoredPowerRatio>
            <MaxPowerOutput>1</MaxPowerOutput>
            <RequiredPowerInput>1</RequiredPowerInput>
            <AdaptibleInput>true</AdaptibleInput>
            <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
            <DamagedSound>ParticleHeavyMech</DamagedSound>
            <PrimarySound>BlockBattery</PrimarySound>
            <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
            <DestroySound>WepSmallWarheadExpl</DestroySound>
            <PCU>15</PCU>
            <IsAirTight>false</IsAirTight>
            <EmissiveColorPreset>Default</EmissiveColorPreset>
        </Definition>

    </CubeBlocks>
</Definitions>
