<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <CubeBlocks>

        <!-- ============================= -->
        <!-- T2 FURNACE                    -->
        <!-- Glass, CarbonBlock, CobaltPlate -->
        <!-- Based on IO SiliconFuser      -->
        <!-- ============================= -->

        <Definition xsi:type="MyObjectBuilder_AssemblerDefinition">
            <Id>
                <TypeId>Assembler</TypeId>
                <SubtypeId>T2_Furnace</SubtypeId>
            </Id>
            <DisplayName>Furnace</DisplayName>
            <Icon>Icons\t2.dds</Icon>
            <Icon>..\2344068716\Icons\production\silicon_fuser_t1.dds</Icon>
            <Description>High-temperature furnace for melting and fusing materials into glass, carbon blocks, and cobalt alloy plates.

Power Usage: 2 MW</Description>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="3" y="3" z="5" />
            <ModelOffset x="0" y="0" z="0" />
            <Model>..\2344068716\Models\SiliconFuser.mwm</Model>
            <Components>
                <Component Subtype="IronFrameL" Count="1" />
                <Component Subtype="CobaltPlate" Count="60" />
                <Component Subtype="IronPipe" Count="20" />
                <Component Subtype="IronBolt" Count="30" />
                <Component Subtype="BasicComputer" Count="5" />
                <Component Subtype="CobaltPlate" Count="15" />
            </Components>
            <CriticalComponent Subtype="BasicComputer" Index="0" />
            <MountPoints>
                <MountPoint Side="Front" StartX="1" StartY="0" EndX="2" EndY="1" />
                <MountPoint Side="Back" StartX="1" StartY="0" EndX="2" EndY="1" />
                <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="3" EndY="5" Default="true" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\AssemblerConstruction_1.mwm" />
                <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\AssemblerConstruction_2.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\AssemblerConstruction_3.mwm" />
            </BuildProgressModels>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>90</BuildTimeSeconds>
            <ResourceSinkGroup>Factory</ResourceSinkGroup>
            <InventoryMaxVolume>4</InventoryMaxVolume>
            <InventorySize>
                <X>1</X>
                <Y>1</Y>
                <Z>1</Z>
            </InventorySize>
            <StandbyPowerConsumption>0.001</StandbyPowerConsumption>
            <OperationalPowerConsumption>2</OperationalPowerConsumption>
            <BlueprintClasses>
                <Class>T2Furnace</Class>
            </BlueprintClasses>
            <AssemblySpeed>1.0</AssemblySpeed>
            <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
            <DamagedSound>ParticleHeavyMech</DamagedSound>
            <PrimarySound>BlockAssembler</PrimarySound>
            <ActionSound>BlockAssemblerProcess</ActionSound>
            <DestroyEffect>Explosion_Missile</DestroyEffect>
            <DestroySound>WepSmallMissileExpl</DestroySound>
            <PCU>40</PCU>
            <IsAirTight>true</IsAirTight>
            <EmissiveColorPreset>Extended</EmissiveColorPreset>
            <AllowSelfPulling>true</AllowSelfPulling>
        </Definition>

        <!-- ============================= -->
        <!-- T2 ELECTRONICS FABRICATOR     -->
        <!-- PCBs, Computers, Displays,    -->
        <!-- Sensors, Medical, PowerCell   -->
        <!-- ============================= -->

        <Definition xsi:type="MyObjectBuilder_AssemblerDefinition">
            <Id>
                <TypeId>Assembler</TypeId>
                <SubtypeId>T2_ElectronicsFabricator</SubtypeId>
            </Id>
            <DisplayName>Electronics Fabricator</DisplayName>
            <Icon>Icons\t2.dds</Icon>
            <Icon>Textures\GUI\Icons\Cubes\assembler.dds</Icon>
            <Description>Precision electronics assembly station. Produces circuit boards, computers, displays, sensors, and medical components.

Power Usage: 1 MW</Description>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="1" y="1" z="2" />
            <ModelOffset x="0" y="0" z="0" />
            <Model>Models\Cubes\Large\Assembler.mwm</Model>
            <Components>
                <Component Subtype="IronFrameL" Count="1" />
                <Component Subtype="CobaltPlate" Count="30" />
                <Component Subtype="CopperWire" Count="20" />
                <Component Subtype="IronBolt" Count="20" />
                <Component Subtype="SiliciumWafer" Count="10" />
                <Component Subtype="BasicComputer" Count="8" />
                <Component Subtype="CobaltPlate" Count="10" />
            </Components>
            <CriticalComponent Subtype="BasicComputer" Index="0" />
            <MountPoints>
                <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
                <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Top" StartX="0" StartY="0.5" EndX="1" EndY="1" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\AssemblerConstruction_1.mwm" />
                <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\AssemblerConstruction_2.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\AssemblerConstruction_3.mwm" />
            </BuildProgressModels>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>70</BuildTimeSeconds>
            <ResourceSinkGroup>Factory</ResourceSinkGroup>
            <InventoryMaxVolume>4</InventoryMaxVolume>
            <InventorySize>
                <X>1</X>
                <Y>1</Y>
                <Z>1</Z>
            </InventorySize>
            <StandbyPowerConsumption>0.001</StandbyPowerConsumption>
            <OperationalPowerConsumption>1</OperationalPowerConsumption>
            <BlueprintClasses>
                <Class>T2ElectronicsFabricator</Class>
            </BlueprintClasses>
            <AssemblySpeed>1.0</AssemblySpeed>
            <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
            <DamagedSound>ParticleHeavyMech</DamagedSound>
            <PrimarySound>BlockAssembler</PrimarySound>
            <ActionSound>BlockAssemblerProcess</ActionSound>
            <DestroyEffect>Explosion_Missile</DestroyEffect>
            <DestroySound>WepSmallMissileExpl</DestroySound>
            <PCU>40</PCU>
            <IsAirTight>true</IsAirTight>
            <EmissiveColorPreset>Extended</EmissiveColorPreset>
            <AllowSelfPulling>true</AllowSelfPulling>
        </Definition>

        <!-- ============================= -->
        <!-- T2 HYDRAULIC PRESS            -->
        <!-- CobaltPlate, ThrustComponent  -->
        <!-- ============================= -->

        <Definition xsi:type="MyObjectBuilder_AssemblerDefinition">
            <Id>
                <TypeId>Assembler</TypeId>
                <SubtypeId>T2_HydraulicPress</SubtypeId>
            </Id>
            <DisplayName>T2 Hydraulic Press</DisplayName>
            <Icon>Icons\t2.dds</Icon>
            <Icon>..\2344068716\Icons\PlateStamp.dds</Icon>
            <Description>High-pressure press for forming cobalt alloy plates and thrust components.

Power Usage: 1 MW</Description>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="2" y="3" z="3" />
            <ModelOffset x="0" y="0" z="0" />
            <Center x="0" y="0" z="1" />
            <Model>..\2344068716\Models\PlateStamp.mwm</Model>
            <Components>
                <Component Subtype="IronFrameL" Count="1" />
                <Component Subtype="CobaltPlate" Count="80" />
                <Component Subtype="IronPipe" Count="15" />
                <Component Subtype="IronBolt" Count="40" />
                <Component Subtype="SimpleBearing" Count="6" />
                <Component Subtype="BasicComputer" Count="4" />
                <Component Subtype="CobaltPlate" Count="20" />
            </Components>
            <CriticalComponent Subtype="BasicComputer" Index="0" />
            <MountPoints>
                <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="2" EndY="3" Default="true" />
                <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Front" StartX="1" StartY="0" EndX="2" EndY="1" />
                <MountPoint Side="Right" StartX="1" StartY="0" EndX="2" EndY="1" />
                <MountPoint Side="Top" StartX="0" StartY="0.5" EndX="1" EndY="2.5" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.33" File="..\2344068716\Models\Construct\PressConstruct1.mwm" />
                <Model BuildPercentUpperBound="0.66" File="..\2344068716\Models\Construct\PressConstruct2.mwm" />
                <Model BuildPercentUpperBound="1.00" File="..\2344068716\Models\Construct\PressConstruct3.mwm" />
            </BuildProgressModels>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>80</BuildTimeSeconds>
            <ResourceSinkGroup>Factory</ResourceSinkGroup>
            <InventoryMaxVolume>4</InventoryMaxVolume>
            <InventorySize>
                <X>1</X>
                <Y>1</Y>
                <Z>1</Z>
            </InventorySize>
            <StandbyPowerConsumption>0.001</StandbyPowerConsumption>
            <OperationalPowerConsumption>1</OperationalPowerConsumption>
            <BlueprintClasses>
                <Class>T1Stamp</Class>
                <Class>T2Stamp</Class>
            </BlueprintClasses>
            <AssemblySpeed>1.5</AssemblySpeed>
            <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
            <DamagedSound>ParticleHeavyMech</DamagedSound>
            <PrimarySound>BlockAssembler</PrimarySound>
            <ActionSound>BlockAssemblerProcess</ActionSound>
            <DestroyEffect>Explosion_Missile</DestroyEffect>
            <DestroySound>WepSmallMissileExpl</DestroySound>
            <PCU>40</PCU>
            <IsAirTight>true</IsAirTight>
            <EmissiveColorPreset>Extended</EmissiveColorPreset>
            <AllowSelfPulling>true</AllowSelfPulling>
        </Definition>

        <!-- ============================= -->
        <!-- T2 METAL EXTRUDER             -->
        <!-- CopperWire                    -->
        <!-- ============================= -->

        <Definition xsi:type="MyObjectBuilder_AssemblerDefinition">
            <Id>
                <TypeId>Assembler</TypeId>
                <SubtypeId>T2_MetalExtruder</SubtypeId>
            </Id>
            <DisplayName>T2 Metal Extruder</DisplayName>
            <Icon>Icons\t2.dds</Icon>
            <Icon>..\2344068716\Icons\Extruder.dds</Icon>
            <Description>Precision drawing machine for extruding copper into fine wire.

Power Usage: 1 MW</Description>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="2" y="1" z="1" />
            <ModelOffset x="0" y="0" z="0" />
            <Model>..\2344068716\Models\Extruder.mwm</Model>
            <Components>
                <Component Subtype="IronFrameL" Count="1" />
                <Component Subtype="CobaltPlate" Count="50" />
                <Component Subtype="IronPipe" Count="10" />
                <Component Subtype="IronBolt" Count="30" />
                <Component Subtype="SimpleBearing" Count="5" />
                <Component Subtype="BasicComputer" Count="3" />
                <Component Subtype="CobaltPlate" Count="15" />
            </Components>
            <CriticalComponent Subtype="BasicComputer" Index="0" />
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.50" File="..\2344068716\Models\Construct\Generic2x2Construct1.mwm" />
                <Model BuildPercentUpperBound="1.00" File="..\2344068716\Models\Construct\Generic2x2Construct2.mwm" />
            </BuildProgressModels>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>65</BuildTimeSeconds>
            <ResourceSinkGroup>Factory</ResourceSinkGroup>
            <InventoryMaxVolume>4</InventoryMaxVolume>
            <InventorySize>
                <X>1</X>
                <Y>1</Y>
                <Z>1</Z>
            </InventorySize>
            <StandbyPowerConsumption>0.001</StandbyPowerConsumption>
            <OperationalPowerConsumption>1</OperationalPowerConsumption>
            <BlueprintClasses>
                <Class>T1Extruder</Class>
                <Class>T2Extruder</Class>
            </BlueprintClasses>
            <AssemblySpeed>1.5</AssemblySpeed>
            <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
            <DamagedSound>ParticleHeavyMech</DamagedSound>
            <PrimarySound>BlockAssembler</PrimarySound>
            <ActionSound>BlockAssemblerProcess</ActionSound>
            <DestroyEffect>Explosion_Missile</DestroyEffect>
            <DestroySound>WepSmallMissileExpl</DestroySound>
            <PCU>40</PCU>
            <IsAirTight>true</IsAirTight>
            <EmissiveColorPreset>Extended</EmissiveColorPreset>
            <AllowSelfPulling>true</AllowSelfPulling>
        </Definition>

        <!-- ============================= -->
        <!-- T2 FABRICATOR                 -->
        <!-- ThrustComponent, ComputerChip -->
        <!-- ============================= -->

        <Definition xsi:type="MyObjectBuilder_AssemblerDefinition">
            <Id>
                <TypeId>Assembler</TypeId>
                <SubtypeId>T2_Fabricator</SubtypeId>
            </Id>
            <DisplayName>T2 Fabricator</DisplayName>
            <Icon>Icons\t2.dds</Icon>
            <Icon>Textures\GUI\Icons\Cubes\basicAssembler.dds</Icon>
            <Description>Assembles composite mechanical and electronic sub-assemblies including thrust components and computer chips.

Power Usage: 1 MW</Description>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="1" y="1" z="1" />
            <ModelOffset x="0" y="0" z="0" />
            <Model>Models\Cubes\Large\BasicAssembler.mwm</Model>
            <Components>
                <Component Subtype="IronFrameL" Count="1" />
                <Component Subtype="CobaltPlate" Count="40" />
                <Component Subtype="IronBolt" Count="25" />
                <Component Subtype="CopperWire" Count="12" />
                <Component Subtype="SimpleBearing" Count="4" />
                <Component Subtype="BasicComputer" Count="5" />
                <Component Subtype="CobaltPlate" Count="10" />
            </Components>
            <CriticalComponent Subtype="BasicComputer" Index="0" />
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\BasicAssembler_Construction1.mwm" />
                <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\BasicAssembler_Construction2.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\BasicAssembler_Construction3.mwm" />
            </BuildProgressModels>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>60</BuildTimeSeconds>
            <ResourceSinkGroup>Factory</ResourceSinkGroup>
            <InventoryMaxVolume>4</InventoryMaxVolume>
            <InventorySize>
                <X>1</X>
                <Y>1</Y>
                <Z>1</Z>
            </InventorySize>
            <StandbyPowerConsumption>0.001</StandbyPowerConsumption>
            <OperationalPowerConsumption>1</OperationalPowerConsumption>
            <BlueprintClasses>
                <Class>T1Fabricator</Class>
                <Class>T2Fabricator</Class>
            </BlueprintClasses>
            <AssemblySpeed>1.5</AssemblySpeed>
            <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
            <DamagedSound>ParticleHeavyMech</DamagedSound>
            <PrimarySound>BlockAssembler</PrimarySound>
            <ActionSound>BlockAssemblerProcess</ActionSound>
            <DestroyEffect>Explosion_Missile</DestroyEffect>
            <DestroySound>WepSmallMissileExpl</DestroySound>
            <PCU>40</PCU>
            <IsAirTight>true</IsAirTight>
            <EmissiveColorPreset>Extended</EmissiveColorPreset>
            <AllowSelfPulling>true</AllowSelfPulling>
        </Definition>

    </CubeBlocks>
</Definitions>
