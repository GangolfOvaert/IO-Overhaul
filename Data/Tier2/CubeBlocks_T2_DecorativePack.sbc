            <Components>
                <Component Subtype="MagnesiumPressedPlate" Count="30" />
                <Component Subtype="IronBolt" Count="20" />
                <Component Subtype="Display" Count="4" />
                <Component Subtype="Glass" Count="10" />
                <Component Subtype="IronBolt" Count="10" />
            </Components>
            <CriticalComponent Subtype="Glass" Index="0" />
            <MountPoints>
                <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
                <MountPoint Side="Left" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Front" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="0.1" />
                <MountPoint Side="Back" StartX="0" StartY="0.9" EndX="1" EndY="1" />
                <MountPoint Side="Back" StartX="0" StartY="0.1" EndX="0.1" EndY="0.9" />
                <MountPoint Side="Back" StartX="0.8" StartY="0.1" EndX="1" EndY="0.9" />
                <MountPoint Side="Top" StartX="0" StartY="0" EndX="1" EndY="1" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\LockerRoomConstruction_1.mwm" />
                <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\LockerRoomConstruction_2.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\LockerRoomConstruction_3.mwm" />
            </BuildProgressModels>
            <BlockPairName>LockerRoom</BlockPairName>
            <MirroringZ>Y</MirroringZ>
            <MirroringY>Z</MirroringY>
            <EdgeType>Light</EdgeType>
            <EmissiveColorPreset>Basic</EmissiveColorPreset>
            <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
            <DamagedSound>ParticleElectrical</DamagedSound>
            <BuildTimeSeconds>14</BuildTimeSeconds>
            <PCU>10</PCU>
            <DLC>DecorativeBlocks</DLC>
        </Definition>

        <!-- Locker Room Corner -->
        <Definition xsi:type="MyObjectBuilder_CargoContainerDefinition">
            <Id>
                <TypeId>CargoContainer</TypeId>
                <SubtypeId>LargeBlockLockerRoomCorner</SubtypeId>
            </Id>
            <DisplayName>DisplayName_Block_LockerRoomCorner</DisplayName>
            <Icon>Icons\t2.dds</Icon>
            <Icon>Textures\GUI\Icons\Cubes\LockerRoomCorner.dds</Icon>
            <Description>Description_LockerRoom</Description>
            <CubeSize>Large</CubeSize>
            <GuiVisible>false</GuiVisible>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="1" y="1" z="1" />
            <Model>Models\Cubes\Large\LockerRoomCorner.mwm</Model>
            <ModelOffset x="0" y="0" z="0" />
            <Components>
                <Component Subtype="MagnesiumPressedPlate" Count="25" />
                <Component Subtype="IronBolt" Count="15" />
                <Component Subtype="Display" Count="4" />
                <Component Subtype="Glass" Count="10" />
                <Component Subtype="IronBolt" Count="15" />
            </Components>
            <CriticalComponent Subtype="Glass" Index="0" />
            <MountPoints>
                <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="0.28" Default="true" />
                <MountPoint Side="Bottom" StartX="0.72" StartY="0.7" EndX="1" EndY="1" Default="true" />
                <MountPoint Side="Bottom" StartX="0.62" StartY="0.28" EndX="1" EndY="0.7" Default="true" />
                <MountPoint Side="Left" StartX="0" StartY="0" EndX="0.2" EndY="1" />
                <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Front" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Back" StartX="0.8" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Top" StartX="0" StartY="0.76" EndX="1" EndY="1" />
                <MountPoint Side="Top" StartX="0.78" StartY="0" EndX="1" EndY="0.3" />
                <MountPoint Side="Top" StartX="0.68" StartY="0.3" EndX="1" EndY="0.76" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\LockerRoomCornerConstruction_1.mwm" />
                <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\LockerRoomCornerConstruction_2.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\LockerRoomCornerConstruction_3.mwm" />
            </BuildProgressModels>
            <BlockPairName>LockerRoomCorner</BlockPairName>
            <MirroringX>MinusHalfY</MirroringX>
            <MirroringY>ZHalfY</MirroringY>
            <MirroringZ>HalfY</MirroringZ>
            <EdgeType>Light</EdgeType>
            <EmissiveColorPreset>Basic</EmissiveColorPreset>
            <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
            <DamagedSound>ParticleElectrical</DamagedSound>
            <BuildTimeSeconds>14</BuildTimeSeconds>
            <PCU>10</PCU>
            <DLC>DecorativeBlocks</DLC>
        </Definition>

        <!-- Planters -->
