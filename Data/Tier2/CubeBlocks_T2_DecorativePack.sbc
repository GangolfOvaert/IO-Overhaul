        <!-- Lockers -->
        <Definition xsi:type="MyObjectBuilder_CargoContainerDefinition">
            <Id>
                <TypeId>CargoContainer</TypeId>
                <SubtypeId>LargeBlockLockers</SubtypeId>
            </Id>
            <DisplayName>DisplayName_Block_Lockers</DisplayName>
