<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <CubeBlocks>
        <!-- Decorative Blocks - Tier 2 (require Glass, Display, or Computer) -->

        <!-- Kitchen -->
        <Definition xsi:type="MyObjectBuilder_KitchenDefinition">
            <Id>
                <TypeId>Kitchen</TypeId>
                <SubtypeId>LargeBlockKitchen</SubtypeId>
            </Id>
            <DisplayName>DisplayName_Block_Kitchen</DisplayName>
            <Icon>Icons\t2.dds</Icon>
            <Icon>Textures\GUI\Icons\Cubes\Kitchen.dds</Icon>
            <Description>Description_Kitchen</Description>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="1" y="1" z="1" />
            <Model>Models\Cubes\Large\Kitchen.mwm</Model>
            <ModelOffset x="0" y="0" z="0" />
            <Components>
                <Component Subtype="MagnesiumPressedPlate" Count="20" />
                <Component Subtype="IronBolt" Count="30" />
                <Component Subtype="IronPipe" Count="6" />
                <Component Subtype="SimpleBearing" Count="6" />
                <Component Subtype="Glass" Count="4" />
            </Components>
            <CriticalComponent Subtype="SimpleBearing" Index="0" />
            <MountPoints>
                <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="0.25" Default="true" />
                <MountPoint Side="Left" StartX="0" StartY="0" EndX="0.25" EndY="1" />
                <MountPoint Side="Right" StartX="0.75" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Front" StartX="0" StartY="0" EndX="1" EndY="0.35" />
                <MountPoint Side="Front" StartX="0" StartY="0.72" EndX="1" EndY="1" />
                <MountPoint Side="Front" StartX="0" StartY="0.35" EndX="0.1" EndY="0.72" />
                <MountPoint Side="Front" StartX="0.9" StartY="0.35" EndX="1" EndY="0.72" />
                <MountPoint Side="Top" StartX="0" StartY="0.75" EndX="1" EndY="1" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\KitchenConstruction_1.mwm" />
                <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\KitchenConstruction_2.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\KitchenConstruction_3.mwm" />
            </BuildProgressModels>
            <BlockPairName>Kitchen</BlockPairName>
            <MirroringZ>Y</MirroringZ>
            <MirroringY>Z</MirroringY>
            <EdgeType>Light</EdgeType>
            <DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
            <DamagedSound>ParticleWeapExpl</DamagedSound>
            <BuildTimeSeconds>14</BuildTimeSeconds>
            <PCU>1</PCU>
            <DLC>DecorativeBlocks</DLC>
            <IsAirTight>false</IsAirTight>
        </Definition>

        <!-- Bed -->
        <Definition xsi:type="MyObjectBuilder_CryoChamberDefinition">
            <Id>
                <TypeId>CryoChamber</TypeId>
                <SubtypeId>LargeBlockBed</SubtypeId>
            </Id>
            <DisplayName>DisplayName_Block_Bed</DisplayName>
            <Icon>Icons\t2.dds</Icon>
            <Icon>Textures\GUI\Icons\Cubes\Bed.dds</Icon>
            <Description>Description_Bed</Description>
            <CubeSize>Large</CubeSize>
            <GuiVisible>false</GuiVisible>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="1" y="1" z="1" />
            <Model>Models\Cubes\Large\Bed.mwm</Model>
            <ModelOffset x="0" y="0" z="0" />
            <CharacterAnimation>Bed_Laying_Pose</CharacterAnimation>
            <Components>
                <Component Subtype="MagnesiumPressedPlate" Count="30" />
                <Component Subtype="IronBolt" Count="20" />
                <Component Subtype="IronTube" Count="8" />
                <Component Subtype="Glass" Count="10" />
                <Component Subtype="IronBolt" Count="10" />
            </Components>
            <CriticalComponent Subtype="Glass" Index="0" />
            <MountPoints>
                <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
                <MountPoint Side="Left" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="0.3" />
                <MountPoint Side="Right" StartX="0" StartY="0.8" EndX="1" EndY="1" />
                <MountPoint Side="Front" StartX="0.85" StartY="0.25" EndX="1" EndY="0.85" />
                <MountPoint Side="Front" StartX="0" StartY="0" EndX="1" EndY="0.25" />
                <MountPoint Side="Front" StartX="0" StartY="0.85" EndX="1" EndY="1" />
                <MountPoint Side="Back" StartX="0" StartY="0.25" EndX="0.15" EndY="0.85" />
                <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="0.25" />
                <MountPoint Side="Back" StartX="0" StartY="0.85" EndX="1" EndY="1" />
                <MountPoint Side="Top" StartX="0" StartY="0" EndX="1" EndY="1" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\BedConstruction_1.mwm" />
                <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\BedConstruction_2.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\BedConstruction_3.mwm" />
            </BuildProgressModels>
            <VoxelPlacement>
                <StaticMode>
                    <PlacementMode>Volumetric</PlacementMode>
                    <MaxAllowed>0.15</MaxAllowed>
                    <MinAllowed>0</MinAllowed>
                </StaticMode>
                <DynamicMode>
                    <PlacementMode>Volumetric</PlacementMode>
                    <MaxAllowed>0.15</MaxAllowed>
                    <MinAllowed>0</MinAllowed>
                </DynamicMode>
            </VoxelPlacement>
            <BlockPairName>Bed</BlockPairName>
            <MirroringX>Y</MirroringX>
            <MirroringY>X</MirroringY>
            <EdgeType>Light</EdgeType>
            <EnableFirstPerson>true</EnableFirstPerson>
            <EnableShipControl>false</EnableShipControl>
            <EnableBuilderCockpit>false</EnableBuilderCockpit>
            <IsPressurized>false</IsPressurized>
            <HasInventory>false</HasInventory>
            <OxygenCapacity>1</OxygenCapacity>
            <ResourceSinkGroup>Utility</ResourceSinkGroup>
            <IdlePowerConsumption>0.00003</IdlePowerConsumption>
            <EmissiveColorPreset>Extended</EmissiveColorPreset>
            <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
            <DamagedSound>ParticleElectrical</DamagedSound>
            <BuildTimeSeconds>14</BuildTimeSeconds>
            <PCU>15</PCU>
            <DLC>DecorativeBlocks</DLC>
        </Definition>

        <!-- Locker Room -->
        <Definition xsi:type="MyObjectBuilder_CargoContainerDefinition">
            <Id>
                <TypeId>CargoContainer</TypeId>
                <SubtypeId>LargeBlockLockerRoom</SubtypeId>
            </Id>
            <DisplayName>DisplayName_Block_LockerRoom</DisplayName>
            <Icon>Icons\t2.dds</Icon>
