<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <CubeBlocks>

        <!-- ============================================ -->
        <!-- TIER 2 WINDOWS                               -->
        <!-- All window variants (Large + Small grid)      -->
        <!-- Girder -> AluminumRod                             -->
        <!-- BulletproofGlass -> Glass     -->
        <!-- InteriorPlate -> Glass        -->
        <!-- Construction -> IronBolt                     -->
        <!-- SmallTube -> IronTube                        -->
        <!-- ============================================ -->
        <Definition>
            <Id>
                <TypeId>CubeBlock</TypeId>
                <SubtypeId>LargeWindowSquare</SubtypeId>
            </Id>
            <DisplayName>DisplayName_Block_VerticalWindow</DisplayName>
            <Icon>Icons\t2.dds</Icon>
            <Icon>Textures\GUI\Icons\Cubes\window.dds</Icon>
            <Description>Description_VerticalWindow</Description>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="1" y="1" z="1" />
            <ModelOffset x="0" y="0" z="0" />
            <Model>Models\Cubes\Large\WindowSquare.mwm</Model>
            <Components>
                <Component Subtype="AluminumFrameL" Count="1" />
                <Component Subtype="Glass" Count="12" />
                <Component Subtype="IronBolt" Count="8" />
                <Component Subtype="IronTube" Count="4" />
            </Components>
            <CriticalComponent Subtype="IronBolt" Index="0" />
            <MountPoints>
                <MountPoint Side="Top" StartX="0" StartY="0.8" EndX="1" EndY="1" />
                <MountPoint Side="Front" StartX="0" StartY="0" EndX="0.1" EndY="1" />
                <MountPoint Side="Front" StartX="0.9" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="0.2" />
                <MountPoint Side="Left" StartX="0" StartY="0" EndX="0.2" EndY="1" />
                <MountPoint Side="Right" StartX="0.8" StartY="0" EndX="1" EndY="1" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.50" File="Models\Cubes\Large\WindowSquareConstruction_1.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\WindowSquareConstruction_2.mwm" />
            </BuildProgressModels>
            <BlockPairName>VerticalWindow</BlockPairName>
            <MirroringZ>Y</MirroringZ>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>10</BuildTimeSeconds>
            <PCU>1</PCU>
            <IsAirTight>false</IsAirTight>
        </Definition>
        <Definition>
            <Id>
                <TypeId>CubeBlock</TypeId>
                <SubtypeId>LargeWindowEdge</SubtypeId>
            </Id>
            <DisplayName>DisplayName_Block_DiagonalWindow</DisplayName>
            <Icon>Icons\t2.dds</Icon>
            <Icon>Textures\GUI\Icons\Cubes\window2.dds</Icon>
            <Description>Description_DiagonalWindow</Description>
            <GuiVisible>false</GuiVisible>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="1" y="1" z="1" />
            <ModelOffset x="0" y="0" z="0" />
            <Model>Models\Cubes\Large\WindowEdge.mwm</Model>
            <Components>
                <Component Subtype="AluminumFrameL" Count="1" />
                <Component Subtype="Glass" Count="16" />
                <Component Subtype="IronBolt" Count="12" />
                <Component Subtype="IronTube" Count="6" />
            </Components>
            <CriticalComponent Subtype="IronBolt" Index="0" />
            <MountPoints>
                <MountPoint Side="Back" ExclusionMask="1" PropertiesMask="2" StartX="0" StartY="0.85" EndX="1" EndY="1" />
                <MountPoint Side="Bottom" ExclusionMask="1" PropertiesMask="2" StartX="0" StartY="0" EndX="1" EndY="0.15" />
                <MountPoint Side="Left" ExclusionMask="1" PropertiesMask="2" StartX="0" StartY="0" EndX="0.25" EndY="0.25" />
                <MountPoint Side="Left" ExclusionMask="1" PropertiesMask="2" StartX="0.25" StartY="0.1" EndX="0.5" EndY="0.5" />
                <MountPoint Side="Left" ExclusionMask="1" PropertiesMask="2" StartX="0.5" StartY="0.35" EndX="0.75" EndY="0.75" />
                <MountPoint Side="Left" ExclusionMask="1" PropertiesMask="2" StartX="0.75" StartY="0.6" EndX="1" EndY="1" />
                <MountPoint Side="Right" ExclusionMask="1" PropertiesMask="2" StartX="0" StartY="0.6" EndX="0.25" EndY="1" />
                <MountPoint Side="Right" ExclusionMask="1" PropertiesMask="2" StartX="0.25" StartY="0.35" EndX="0.5" EndY="0.75" />
                <MountPoint Side="Right" ExclusionMask="1" PropertiesMask="2" StartX="0.5" StartY="0.1" EndX="0.75" EndY="0.5" />
                <MountPoint Side="Right" ExclusionMask="1" PropertiesMask="2" StartX="0.75" StartY="0" EndX="1" EndY="0.25" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.50" File="Models\Cubes\Large\WindowEdgeConstruction_1.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\WindowEdgeConstruction_2.mwm" />
            </BuildProgressModels>
            <BlockPairName>DiagonalWindow</BlockPairName>
            <MirroringY>Z</MirroringY>
            <MirroringZ>Y</MirroringZ>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>12</BuildTimeSeconds>
            <PCU>1</PCU>
            <IsAirTight>false</IsAirTight>
        </Definition>

        <!-- Region Large grid Window-->
        <Definition>
            <Id>
                <TypeId>CubeBlock</TypeId>
