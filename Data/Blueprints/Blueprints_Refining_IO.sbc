    <!-- Nuclear Processing Blueprints -->

    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>SpentFuelReprocessing</SubtypeId>
      </Id>
      <DisplayName>Spent Fuel Reprocessing</DisplayName>
      <Icon>Icons\SpentUranium.dds</Icon>
      <Prerequisites>
        <Item Amount="2" TypeId="Ingot" SubtypeId="SpentFuel" />
      </Prerequisites>
      <Results>
        <Item Amount="1" TypeId="Ingot" SubtypeId="Uranium" />
        <Item Amount="1" TypeId="Ingot" SubtypeId="NuclearWaste" />
      </Results>
      <BaseProductionTimeInSeconds>60</BaseProductionTimeInSeconds>
      <Public>false</Public>
    </Blueprint>

    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>DepletedUraniumProcessing</SubtypeId>
      </Id>
      <DisplayName>Depleted Uranium Processing</DisplayName>
      <Icon>Icons\DepletedUranium.dds</Icon>
      <Prerequisites>
        <Item Amount="2" TypeId="Ingot" SubtypeId="DepletedUranium" />
      </Prerequisites>
      <Results>
        <Item Amount="1" TypeId="Ingot" SubtypeId="Uranium" />
        <Item Amount="1" TypeId="Ingot" SubtypeId="NuclearWaste" />
