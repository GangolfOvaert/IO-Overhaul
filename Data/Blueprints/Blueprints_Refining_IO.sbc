      </Prerequisites>
      <Results>
        <Item Amount="1" TypeId="Component" SubtypeId="Ceramic" />
      </Results>
      <BaseProductionTimeInSeconds>120</BaseProductionTimeInSeconds>
      <Public>false</Public>
    </Blueprint>

    <!-- Gunpowder Blueprint -->

