        <Item Amount="3" TypeId="Ingot" SubtypeId="Niter" />
      </Prerequisites>
      <Result Amount="1" TypeId="Ingot" SubtypeId="Magnesium" />
      <BaseProductionTimeInSeconds>0.5</BaseProductionTimeInSeconds>
