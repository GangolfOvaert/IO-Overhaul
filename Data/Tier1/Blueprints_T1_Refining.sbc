<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Blueprints>

    <!-- ============================= -->
    <!-- TIER 1 ORE REFINING           -->
    <!-- Impure Ores: 25% Efficiency   -->
    <!-- Normal Ores: 60% Efficiency   -->
    <!-- Pure Ores: 80% Efficiency     -->
    <!-- Stone Metals: 30% Efficiency  -->
    <!-- ============================= -->

    <!-- ========== IMPURE ORES (25%) ========== -->

    <!-- Impure Iron Ore: 25% yield -->
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>T1_IronOreImpureToIngot</SubtypeId>
      </Id>
      <DisplayName>Iron Ingot (Impure)</DisplayName>
      <Icon>Icons\t1.dds</Icon>
      <Icon>Textures\GUI\Icons\ingot\iron_ingot.dds</Icon>
      <Prerequisites>
        <Item Amount="1000" TypeId="Ore" SubtypeId="IronOreImpure" />
      </Prerequisites>
      <Result Amount="250" TypeId="Ingot" SubtypeId="Iron" />
      <BaseProductionTimeInSeconds>750</BaseProductionTimeInSeconds>
      <IsPrimary>true</IsPrimary>
    </Blueprint>



    <!-- Impure Nickel Ore: 25% yield -->
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>T1_NickelOreImpureToIngot</SubtypeId>
      </Id>
      <DisplayName>Nickel Ingot (Impure)</DisplayName>
      <Icon>Icons\t1.dds</Icon>
      <Icon>Textures\GUI\Icons\ingot\nickel_ingot.dds</Icon>
      <Prerequisites>
        <Item Amount="1000" TypeId="Ore" SubtypeId="NickelOreImpure" />
      </Prerequisites>
      <Result Amount="250" TypeId="Ingot" SubtypeId="Nickel" />
      <BaseProductionTimeInSeconds>750</BaseProductionTimeInSeconds>
      <IsPrimary>true</IsPrimary>
    </Blueprint>

    <!-- Impure Magnesium Ore: 25% yield -->
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>T1_MagnesiumOreImpureToIngot</SubtypeId>
