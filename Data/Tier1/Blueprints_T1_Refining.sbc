      <Prerequisites>
        <Item Amount="1000" TypeId="Ore" SubtypeId="MagnesiumOreImpure" />
      </Prerequisites>
      <Result Amount="250" TypeId="Ingot" SubtypeId="Magnesium" />
      <BaseProductionTimeInSeconds>750</BaseProductionTimeInSeconds>
      <IsPrimary>true</IsPrimary>
    </Blueprint>

