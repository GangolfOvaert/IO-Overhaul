    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>T1_MagnesiumOrePureToIngot</SubtypeId>
      </Id>
      <DisplayName>Magnesium Powder (Pure)</DisplayName>
      <Icon>Icons\t1.dds</Icon>
