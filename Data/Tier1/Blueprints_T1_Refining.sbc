    </Blueprint>

    <!-- ========== STONE PROCESSING ========== -->

    <!-- Stone: 50 Gravel + 30% Metals (3 Iron, 3 Nickel) -->
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>T1_StoneProcessing</SubtypeId>
      </Id>
      <DisplayName>Stone Processing</DisplayName>
      <Icon>Icons\t1.dds</Icon>
      <Icon>Textures\GUI\Icons\ingot\gravel_ingot.dds</Icon>
      <Prerequisites>
        <Item Amount="100000" TypeId="Ore" SubtypeId="Stone" />
      </Prerequisites>
      <Results>
        <Item Amount="50000" TypeId="Ingot" SubtypeId="Stone" />
        <Item Amount="3000" TypeId="Ingot" SubtypeId="Iron" />
        <Item Amount="3000" TypeId="Ingot" SubtypeId="Nickel" />
      </Results>
      <BaseProductionTimeInSeconds>15000</BaseProductionTimeInSeconds>
      <IsPrimary>true</IsPrimary>
    </Blueprint>

  </Blueprints>
</Definitions>
