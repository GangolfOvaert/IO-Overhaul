    <!-- ========== PURE ORES (80%) ========== -->

    <!-- Pure Iron Ore: 80% yield -->
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>T1_IronOrePureToIngot</SubtypeId>
      </Id>
      <DisplayName>Iron Ingot (Pure)</DisplayName>
      <Icon>Icons\t1.dds</Icon>
      <Icon>Textures\GUI\Icons\ingot\iron_ingot.dds</Icon>
      <Prerequisites>
        <Item Amount="1000" TypeId="Ore" SubtypeId="IronOrePure" />
      </Prerequisites>
      <Result Amount="800" TypeId="Ingot" SubtypeId="Iron" />
      <BaseProductionTimeInSeconds>750</BaseProductionTimeInSeconds>
      <IsPrimary>true</IsPrimary>
