    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>T1_NickelOrePureToIngot</SubtypeId>
      </Id>
      <DisplayName>Nickel Ingot (Pure)</DisplayName>
      <Icon>Icons\t1.dds</Icon>
      <Icon>Textures\GUI\Icons\ingot\nickel_ingot.dds</Icon>
