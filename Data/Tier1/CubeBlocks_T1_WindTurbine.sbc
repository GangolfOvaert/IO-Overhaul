<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>

    <!-- ============================= -->
    <!-- T1 WIND TURBINE               -->
    <!-- Basic wind power, 2MW         -->
    <!-- ============================= -->

    <Definition xsi:type="MyObjectBuilder_WindTurbineDefinition">
      <Id>
        <TypeId>WindTurbine</TypeId>
        <SubtypeId>LargeBlockWindTurbinet1</SubtypeId>
      </Id>
      <DisplayName>Wind Turbine T1</DisplayName>
      <Description>
		Description_WindTurbine
		Nominal Max Output: 2MW
	</Description>
      <Icon>Icons\energy\large_wind_turbine_t1.dds</Icon>
      <CubeSize>Large</CubeSize>
      <PlaceDecals>false</PlaceDecals>
      <ResearchGroup>Tier00Basics</ResearchGroup>
      <ResearchCost>5</ResearchCost>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="3" y="3" z="3" />
      <Center x="1" y="0" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Large\WindTurbine.mwm</Model>
      <Components>
        <Component Subtype="IronFrameL" Count="1" />
        <Component Subtype="IronPlate" Count="100" />
        <Component Subtype="IronBolt" Count="50" />
        <Component Subtype="IronPipe" Count="10" />
        <Component Subtype="SimpleBearing" Count="6" />
        <Component Subtype="IronFrameS" Count="4" />
        <Component Subtype="IronPlate" Count="30" />
      </Components>
      <CriticalComponent Subtype="SimpleBearing" Index="0" />
      <MountPoints>
        <MountPoint Side="Bottom" StartX="1" StartY="1" EndX="2" EndY="2" Default="true" />
      </MountPoints>
      <MirroringY>Z</MirroringY>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\WindTurbine_Construction1.mwm" />
        <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\WindTurbine_Construction2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\WindTurbine_Construction3.mwm" />
      </BuildProgressModels>
      <BlockPairName>WindTurbine</BlockPairName>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>20</BuildTimeSeconds>
      <DamageEffectId>214</DamageEffectId>
      <ActionSound>ArcBlockWindTurbine</ActionSound>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <MaxPowerOutput>2</MaxPowerOutput>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <IsAirTight>false</IsAirTight>
      <VoxelPlacement>
        <StaticMode>
          <PlacementMode>OutsideVoxel</PlacementMode>
        </StaticMode>
        <DynamicMode>
          <PlacementMode>OutsideVoxel</PlacementMode>
        </DynamicMode>
      </VoxelPlacement>
      <RaycasterSize>20</RaycasterSize>
      <RaycastersCount>9</RaycastersCount>
      <MinRaycasterClearance>0.3</MinRaycasterClearance>
      <OptimalGroundClearance>25</OptimalGroundClearance>
      <RaycastersToFullEfficiency>7</RaycastersToFullEfficiency>
      <OptimalWindSpeed>80</OptimalWindSpeed>
      <TurbineSpinUpSpeed>3</TurbineSpinUpSpeed>
      <TurbineSpinDownSpeed>0.3</TurbineSpinDownSpeed>
      <TurbineRotationSpeed>7</TurbineRotationSpeed>
      <PCU>55</PCU>
    </Definition>

    <!-- ============================= -->
    <!-- T1 LARGE WIND TURBINE         -->
    <!-- Upgraded wind power, 4MW      -->
    <!-- ============================= -->

    <Definition xsi:type="MyObjectBuilder_WindTurbineDefinition">
      <Id>
        <TypeId>WindTurbine</TypeId>
        <SubtypeId>LargeWindTurbine</SubtypeId>
      </Id>
      <DisplayName>Large Wind Turbine T1</DisplayName>
      <Description>
		Large blades and an upgraded geartrain provide increased power generation.
		Optimal clearance: 100m
		Optimal height: 50m
		Nominal Output: 4MW
	</Description>
      <Icon>Icons\energy\wind_turbine_t1.dds</Icon>
      <CubeSize>Large</CubeSize>
      <PlaceDecals>false</PlaceDecals>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="3" y="1" z="1" />
      <Center x="1" y="0" z="0" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>..\2344068716\Models\LargeWindTurbine.mwm</Model>
      <Components>
        <Component Subtype="IronFrameL" Count="1" />
        <Component Subtype="IronPlate" Count="200" />
        <Component Subtype="IronBolt" Count="60" />
        <Component Subtype="IronRod" Count="40" />
        <Component Subtype="IronPipe" Count="15" />
        <Component Subtype="SimpleBearing" Count="10" />
        <Component Subtype="IronFrameL" Count="4" />
        <Component Subtype="IronPlate" Count="50" />
      </Components>
      <CriticalComponent Subtype="SimpleBearing" Index="0" />
      <MountPoints>
        <MountPoint Side="Top" StartX="0.2" StartY="0" EndX="2" EndY="1" />
        <MountPoint Side="Back" StartX="0.8" StartY="0" EndX="2" EndY="0.5" />
        <MountPoint Side="Back" StartX="0.2" StartY="0.5" EndX="2" EndY="1" />
        <MountPoint Side="Bottom" StartX="0.8" StartY="0" EndX="2" EndY="1" />
        <MountPoint Side="Front" StartX="1" StartY="0" EndX="2.2" EndY="0.5" />
        <MountPoint Side="Front" StartX="1" StartY="0.5" EndX="2.8" EndY="1" />
      </MountPoints>
      <MirroringX>Y</MirroringX>
      <MirroringY>X</MirroringY>
      <MirroringZ>None</MirroringZ>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="..\2344068716\Models\Construct\LargeWindTurbineConstruct1.mwm" />
        <Model BuildPercentUpperBound="0.66" File="..\2344068716\Models\Construct\LargeWindTurbineConstruct2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="..\2344068716\Models\Construct\LargeWindTurbineConstruct3.mwm" />
      </BuildProgressModels>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>60</BuildTimeSeconds>
      <DamageEffectId>214</DamageEffectId>
      <ActionSound>ArcBlockWindTurbine</ActionSound>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <MaxPowerOutput>6</MaxPowerOutput>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <IsAirTight>false</IsAirTight>
      <VoxelPlacement>
        <StaticMode>
          <PlacementMode>OutsideVoxel</PlacementMode>
        </StaticMode>
        <DynamicMode>
          <PlacementMode>OutsideVoxel</PlacementMode>
        </DynamicMode>
      </VoxelPlacement>
      <RaycasterSize>100</RaycasterSize>
      <RaycastersCount>10</RaycastersCount>
      <MinRaycasterClearance>0.75</MinRaycasterClearance>
      <OptimalGroundClearance>50</OptimalGroundClearance>
      <RaycastersToFullEfficiency>9</RaycastersToFullEfficiency>
      <OptimalWindSpeed>80</OptimalWindSpeed>
      <TurbineSpinUpSpeed>0.25</TurbineSpinUpSpeed>
      <TurbineSpinDownSpeed>0.1</TurbineSpinDownSpeed>
      <TurbineRotationSpeed>-2</TurbineRotationSpeed>
      <PCU>55</PCU>
    </Definition>

  </CubeBlocks>
</Definitions>
