        <!-- Steel Catwalk - Large Grid -->
        <Definition>
            <Id>
                <TypeId>CubeBlock</TypeId>
                <SubtypeId>LargeSteelCatwalk</SubtypeId>
            </Id>
            <DisplayName>DisplayName_Block_SteelCatwalk</DisplayName>
            <Icon>Icons\t1.dds</Icon>
            <Icon>Textures\GUI\Icons\Cubes\SteelCatwalk.dds</Icon>
            <Description>Description_SteelCatwalk</Description>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="1" y="1" z="1" />
            <ModelOffset x="0" y="0" z="0" />
            <Model>Models\Cubes\Large\SteelCatwalk.mwm</Model>
            <Components>
                <Component Subtype="IronFrameL" Count="1" />
                <Component Subtype="MagnesiumPressedPlate" Count="19" />
                <Component Subtype="IronBolt" Count="5" />
                <Component Subtype="IronTube" Count="20" />
                <Component Subtype="MagnesiumPressedPlate" Count="7" />
            </Components>
            <CriticalComponent Subtype="IronTube" Index="0" />
            <MountPoints>
                <MountPoint Side="Left" ExclusionMask="1" PropertiesMask="2" StartX="0" StartY="0" EndX="1" EndY="0.1" />
                <MountPoint Side="Right" ExclusionMask="1" PropertiesMask="2" StartX="0" StartY="0" EndX="1" EndY="0.1" />
                <MountPoint Side="Bottom" ExclusionMask="1" PropertiesMask="2" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
                <MountPoint Side="Back" ExclusionMask="1" PropertiesMask="2" StartX="0" StartY="0" EndX="1" EndY="0.1" />
                <MountPoint Side="Front" ExclusionMask="1" PropertiesMask="2" StartX="0" StartY="0" EndX="1" EndY="0.4" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\SteelCatwalkConstruction_1.mwm" />
            </BuildProgressModels>
            <BlockPairName>SteelCatwalk</BlockPairName>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>10</BuildTimeSeconds>
            <DestroyEffectOffset>
                <X>0</X>
                <Y>-1.1</Y>
                <Z>0</Z>
            </DestroyEffectOffset>
            <PCU>1</PCU>
        </Definition>

