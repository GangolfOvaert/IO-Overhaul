<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>

    <!-- ============================= -->
    <!-- T1 SMELTER (BLAST FURNACE)    -->
    <!-- Basic ore smelting, 2MW       -->
    <!-- ============================= -->

    <Definition xsi:type="MyObjectBuilder_RefineryDefinition">
      <Id>
        <TypeId>Refinery</TypeId>
        <SubtypeId>Blast Furnace</SubtypeId>
      </Id>
      <DisplayName>Smelter T1</DisplayName>
      <Icon>Icons\production\blast_furnace_t1.dds</Icon>
      <Description>
		Smelters can refine Stone, Copper, Iron, Niter.

		Power Usage 2MW
	</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="2" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Large\BasicRefinery.mwm</Model>
      <Components>
        <Component Subtype="IronFrameL" Count="1" />
        <Component Subtype="IronPlate" Count="120" />
        <Component Subtype="IronBolt" Count="50" />
        <Component Subtype="IronRod" Count="30" />
        <Component Subtype="IronPipe" Count="10" />
        <Component Subtype="SimpleBearing" Count="4" />
        <Component Subtype="IronFrameL" Count="2" />
        <Component Subtype="IronPlate" Count="30" />
      </Components>
      <CriticalComponent Subtype="SimpleBearing" Index="0" />
      <MirroringZ>Y</MirroringZ>
      <MirroringY>Z</MirroringY>
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
        <MountPoint Side="Left" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Front" StartX="0" StartY="0" EndX="1" EndY="2" />
      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\BasicRefineryConstruction_1.mwm" />
        <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\BasicRefineryConstruction_2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\BasicRefineryConstruction_3.mwm" />
      </BuildProgressModels>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>40</BuildTimeSeconds>
      <ResourceSinkGroup>Factory</ResourceSinkGroup>
      <InventoryMaxVolume>4</InventoryMaxVolume>
      <InventorySize>
        <X>2</X>
        <Y>2</Y>
        <Z>2</Z>
      </InventorySize>
      <StandbyPowerConsumption>0.001</StandbyPowerConsumption>
      <OperationalPowerConsumption>2</OperationalPowerConsumption>
      <BlueprintClasses>
        <Class>SmelterIngotst1</Class>
      </BlueprintClasses>
      <RefineSpeed>0.2</RefineSpeed>
      <MaterialEfficiency>1.0</MaterialEfficiency>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <PrimarySound>BlockRafinery</PrimarySound>
      <ActionSound>BlockRafineryProcess</ActionSound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <OreAmountPerPullRequest>2000</OreAmountPerPullRequest>
      <PCU>75</PCU>
    </Definition>

    <!-- ============================= -->
    <!-- T1 ROCK CRUSHER               -->
    <!-- Crushes stone and ores, 2.5MW -->
    <!-- ============================= -->

    <Definition xsi:type="MyObjectBuilder_RefineryDefinition">
      <Id>
        <TypeId>Refinery</TypeId>
        <SubtypeId>RockCrusher</SubtypeId>
      </Id>
      <DisplayName>Rock Crusher T1</DisplayName>
      <Icon>Icons\production\ore_crusher_t1.dds</Icon>
      <Description>
                Crushes Stone and Ores. Crushed Ore can be refined more efficiently.

				Power Usage 2.5MW
            </Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="3" y="4" z="3" />
      <Center x="1" y="1" z="1" />
      <Model>..\2344068716\Models\OreCrusher.mwm</Model>
      <Components>
        <Component Subtype="IronFrameXL" Count="1" />
        <Component Subtype="IronPlate" Count="250" />
        <Component Subtype="IronBolt" Count="80" />
        <Component Subtype="IronRod" Count="60" />
        <Component Subtype="IronPipe" Count="20" />
        <Component Subtype="SimpleBearing" Count="10" />
        <Component Subtype="IronFrameL" Count="4" />
        <Component Subtype="IronFrameXL" Count="2" />
        <Component Subtype="IronPlate" Count="50" />
      </Components>
      <CriticalComponent Subtype="SimpleBearing" Index="0" />
      <MountPoints>
        <MountPoint Side="Front" StartX="1.00" StartY="0.00" EndX="2.00" EndY="1.00" />
        <MountPoint Side="Back" StartX="1.00" StartY="3.00" EndX="2.00" EndY="4.00" />
        <MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="3.00" EndY="3.00" />
      </MountPoints>
      <MirroringX>None</MirroringX>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="..\2344068716\Models\Construct\OreCrusherConstruct1.mwm" />
        <Model BuildPercentUpperBound="0.66" File="..\2344068716\Models\Construct\OreCrusherConstruct2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="..\2344068716\Models\Construct\OreCrusherConstruct3.mwm" />
      </BuildProgressModels>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>90</BuildTimeSeconds>
      <ResourceSinkGroup>Factory</ResourceSinkGroup>
      <InventoryMaxVolume>7.5</InventoryMaxVolume>
      <InventorySize>
        <X>2.5</X>
        <Y>2.5</Y>
        <Z>2.5</Z>
      </InventorySize>
      <StandbyPowerConsumption>0.001</StandbyPowerConsumption>
      <OperationalPowerConsumption>2.5</OperationalPowerConsumption>
      <BlueprintClasses>
        <Class>Crushert1</Class>
      </BlueprintClasses>
      <RefineSpeed>1</RefineSpeed>
      <MaterialEfficiency>1.0</MaterialEfficiency>
      <OreAmountPerPullRequest>1000</OreAmountPerPullRequest>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <PrimarySound>BlockRafinery</PrimarySound>
      <ActionSound>RockCrusher</ActionSound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>90</PCU>
    </Definition>

    <!-- ============================= -->
    <!-- T1 ORE PURIFIER               -->
    <!-- Filters crushed ore, 5MW      -->
    <!-- ============================= -->

    <Definition xsi:type="MyObjectBuilder_RefineryDefinition">
      <Id>
        <TypeId>Refinery</TypeId>
        <SubtypeId>OrePurifier</SubtypeId>
      </Id>
      <DisplayName>Ore Purifier T1</DisplayName>
      <Icon>Icons\production\ore_purifier_t1.dds</Icon>
      <Description>
		Filters impurites from Crushed Ore to further increase refining yield.

		Power Usage: 5MW
	</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="3" y="2" z="3" />
      <Center x="1" y="0" z="1" />
      <Model>..\2344068716\Models\OrePurifier.mwm</Model>
      <Components>
        <Component Subtype="IronFrameL" Count="1" />
        <Component Subtype="IronPlate" Count="200" />
        <Component Subtype="IronBolt" Count="100" />
        <Component Subtype="IronRod" Count="60" />
        <Component Subtype="IronPipe" Count="30" />
        <Component Subtype="IronTube" Count="40" />
        <Component Subtype="SimpleBearing" Count="12" />
        <Component Subtype="IronFrameL" Count="4" />
        <Component Subtype="IronPlate" Count="50" />
      </Components>
      <CriticalComponent Subtype="SimpleBearing" Index="0" />
      <Center x="1" y="0" z="1" />
      <MountPoints>
        <MountPoint Side="Left" StartX="1" StartY="1" EndX="2" EndY="2" />
        <MountPoint Side="Right" StartX="1" StartY="0" EndX="2" EndY="1" />
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="3" EndY="3" />
      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.25" File="..\2344068716\Models\Construct\OrePurifierConstruct0.mwm" />
        <Model BuildPercentUpperBound="0.50" File="..\2344068716\Models\Construct\OrePurifierConstruct1.mwm" />
        <Model BuildPercentUpperBound="0.75" File="..\2344068716\Models\Construct\OrePurifierConstruct2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="..\2344068716\Models\Construct\OrePurifierConstruct3.mwm" />
      </BuildProgressModels>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>90</BuildTimeSeconds>
      <ResourceSinkGroup>Factory</ResourceSinkGroup>
      <InventoryMaxVolume>7.5</InventoryMaxVolume>
      <InventorySize>
        <X>2.5</X>
        <Y>2.5</Y>
        <Z>2.5</Z>
      </InventorySize>
      <StandbyPowerConsumption>0.001</StandbyPowerConsumption>
      <OperationalPowerConsumption>5</OperationalPowerConsumption>
      <BlueprintClasses>
        <Class>Purifiert1</Class>
      </BlueprintClasses>
      <RefineSpeed>0.25</RefineSpeed>
      <MaterialEfficiency>1.0</MaterialEfficiency>
      <OreAmountPerPullRequest>1000</OreAmountPerPullRequest>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <PrimarySound>BlockRafinery</PrimarySound>
      <ActionSound>BlockRafineryProcess</ActionSound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>90</PCU>
    </Definition>

    <!-- ============================= -->
    <!-- T1 REFINERY (IO)              -->
    <!-- Full T1 ore refining, 3MW     -->
    <!-- ============================= -->

    <Definition xsi:type="MyObjectBuilder_RefineryDefinition">
      <Id>
        <TypeId>Refinery</TypeId>
        <SubtypeId>LargeRefineryt1</SubtypeId>
      </Id>
      <DisplayName>Refinery T1</DisplayName>
      <Icon>Icons\production\refinery_t1.dds</Icon>
      <Description>
		Refinery can refine T1 Ores

		Power Usage 3MW
	</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="2" y="4" z="2" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Large\Refinery.mwm</Model>
      <Components>
        <Component Subtype="IronFrameL" Count="1" />
        <Component Subtype="IronPlate" Count="250" />
        <Component Subtype="IronBolt" Count="80" />
        <Component Subtype="IronRod" Count="60" />
        <Component Subtype="IronPipe" Count="25" />
        <Component Subtype="IronTube" Count="30" />
        <Component Subtype="SimpleBearing" Count="10" />
        <Component Subtype="IronFrameL" Count="4" />
        <Component Subtype="IronFrameS" Count="6" />
        <Component Subtype="IronPlate" Count="50" />
      </Components>
      <CriticalComponent Subtype="SimpleBearing" Index="0" />
      <Center x="1" y="0" z="1" />
      <MountPoints>
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="2" EndY="4" />
        <MountPoint Side="Bottom" StartX="0" StartY="1" EndX="2" EndY="2" Default="true" />
        <MountPoint Side="Top" StartX="0" StartY="0" EndX="2" EndY="1" />
        <MountPoint Side="Left" StartX="1" StartY="0" EndX="2" EndY="4" />
        <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="4" />
      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.16" File="Models\Cubes\Large\RefineryConstruction_1.mwm" />
        <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\RefineryConstruction_2.mwm" />
        <Model BuildPercentUpperBound="0.50" File="Models\Cubes\Large\RefineryConstruction_3.mwm" />
        <Model BuildPercentUpperBound="0.83" File="Models\Cubes\Large\RefineryConstruction_4.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\RefineryConstruction_5.mwm" />
      </BuildProgressModels>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>90</BuildTimeSeconds>
      <ResourceSinkGroup>Factory</ResourceSinkGroup>
      <InventoryMaxVolume>7.5</InventoryMaxVolume>
      <InventorySize>
        <X>2.5</X>
        <Y>2.5</Y>
        <Z>2.5</Z>
      </InventorySize>
      <StandbyPowerConsumption>0.001</StandbyPowerConsumption>
      <OperationalPowerConsumption>3</OperationalPowerConsumption>
      <BlueprintClasses>
        <Class>refineryIngotst1</Class>
      </BlueprintClasses>
      <RefineSpeed>1</RefineSpeed>
      <MaterialEfficiency>1.0</MaterialEfficiency>
      <OreAmountPerPullRequest>2000</OreAmountPerPullRequest>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <PrimarySound>BlockRafinery</PrimarySound>
      <ActionSound>BlockRafineryProcess</ActionSound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>90</PCU>
    </Definition>

    <!-- ============================= -->
    <!-- T1 INCINERATOR                -->
    <!-- Destroys unwanted items, 5MW  -->
    <!-- ============================= -->

    <Definition xsi:type="MyObjectBuilder_RefineryDefinition">
      <Id>
        <TypeId>Refinery</TypeId>
        <SubtypeId>Incinerator</SubtypeId>
      </Id>
      <DisplayName>Incinerator</DisplayName>
      <Icon>Icons\production\incinerator_t1.dds</Icon>
      <Description>
		Destroys unwanted items placed inside.

		Power Usage: 5MW
	</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="2" y="3" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>..\2344068716\Models\Incinerator.mwm</Model>
      <Components>
        <Component Subtype="IronFrameL" Count="1" />
        <Component Subtype="IronPlate" Count="200" />
        <Component Subtype="IronBolt" Count="60" />
        <Component Subtype="IronPipe" Count="20" />
        <Component Subtype="IronRod" Count="40" />
        <Component Subtype="SimpleBearing" Count="4" />
        <Component Subtype="IronFrameL" Count="2" />
        <Component Subtype="IronPlate" Count="50" />
      </Components>
      <CriticalComponent Subtype="SimpleBearing" Index="0" />
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="2" EndY="1" Default="true" />
        <MountPoint Side="Left" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Left" StartX="0" StartY="1.9" EndX="1" EndY="2.1" />
        <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Back" StartX="0" StartY="1.9" EndX="1" EndY="2.1" />
        <MountPoint Side="Front" StartX="1" StartY="1.9" EndX="2" EndY="2.1" />
      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="..\2344068716\Models\Construct\IncineratorConstruct1.mwm" />
        <Model BuildPercentUpperBound="0.66" File="..\2344068716\Models\Construct\IncineratorConstruct2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="..\2344068716\Models\Construct\IncineratorConstruct3.mwm" />
      </BuildProgressModels>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>90</BuildTimeSeconds>
      <ResourceSinkGroup>Factory</ResourceSinkGroup>
      <InventoryMaxVolume>5</InventoryMaxVolume>
      <InventorySize>
        <X>2.5</X>
        <Y>2.5</Y>
        <Z>2.5</Z>
      </InventorySize>
      <StandbyPowerConsumption>0.001</StandbyPowerConsumption>
      <OperationalPowerConsumption>5</OperationalPowerConsumption>
      <BlueprintClasses>
        <Class>Incinerator</Class>
      </BlueprintClasses>
      <RefineSpeed>5</RefineSpeed>
      <MaterialEfficiency>1.0</MaterialEfficiency>
      <OreAmountPerPullRequest>0</OreAmountPerPullRequest>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <Center x="1" y="0" z="0" />
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <PrimarySound>BlockRafinery</PrimarySound>
      <ActionSound>BlockRafineryProcess</ActionSound>
      <EmissiveColorPreset>Extended</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>90</PCU>
    </Definition>

  </CubeBlocks>
</Definitions>
