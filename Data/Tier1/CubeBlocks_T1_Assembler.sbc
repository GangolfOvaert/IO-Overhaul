<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>

    <!-- ============================= -->
    <!-- T1 HYDRAULIC PRESS            -->
    <!-- Basic component assembler     -->
    <!-- ============================= -->

    <Definition xsi:type="MyObjectBuilder_AssemblerDefinition">
      <Id>
        <TypeId>Assembler</TypeId>
        <SubtypeId>T1_HydraulicPress</SubtypeId>
      </Id>
      <DisplayName>Hydraulic Press</DisplayName>
      <Icon>..\2344068716\Icons\PlateStamp.dds</Icon>
      <Icon>Icons\t1.dds</Icon>
      <Description>A basic hydraulic press for forming iron and magnesium into simple components.
	  
Power Usage: 0.5 MW</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="2" y="3" z="3" />
      <ModelOffset x="0" y="0" z="0" />
      <Center x="0" y="0" z="1" />
      <Model>..\2344068716\Models\PlateStamp.mwm</Model>
      <Components>
        <Component Subtype="IronPlate" Count="80" />
        <Component Subtype="IronRod" Count="40" />
        <Component Subtype="IronBolt" Count="60" />
        <Component Subtype="IronPipe" Count="10" />
        <Component Subtype="SimpleBearing" Count="8" />
        <Component Subtype="IronFrameL" Count="4" />
        <Component Subtype="IronPlate" Count="20" />
      </Components>
      <CriticalComponent Subtype="SimpleBearing" Index="0" />
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="2" EndY="3" />
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Front" StartX="1" StartY="0" EndX="2" EndY="1" />
        <MountPoint Side="Right" StartX="1" StartY="0" EndX="2" EndY="1" />
        <MountPoint Side="Top" StartX="0" StartY="0.5" EndX="1" EndY="2.5" />
      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="..\2344068716\Models\Construct\PressConstruct1.mwm" />
        <Model BuildPercentUpperBound="0.66" File="..\2344068716\Models\Construct\PressConstruct2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="..\2344068716\Models\Construct\PressConstruct3.mwm" />
      </BuildProgressModels>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>60</BuildTimeSeconds>
      <ResourceSinkGroup>Factory</ResourceSinkGroup>
      <InventoryMaxVolume>4</InventoryMaxVolume>
      <InventorySize>
        <X>1</X>
        <Y>1</Y>
        <Z>1</Z>
      </InventorySize>
      <StandbyPowerConsumption>0.001</StandbyPowerConsumption>
      <OperationalPowerConsumption>0.5</OperationalPowerConsumption>
      <BlueprintClasses>
        <Class>T1Stamp</Class>
      </BlueprintClasses>
      <AssemblySpeed>0.75</AssemblySpeed>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <PrimarySound>BlockAssembler</PrimarySound>
      <ActionSound>BlockAssemblerProcess</ActionSound>
      <DestroyEffect>Explosion_Missile</DestroyEffect>
      <DestroySound>WepSmallMissileExpl</DestroySound>
      <PCU>40</PCU>
      <IsAirTight>true</IsAirTight>
      <EmissiveColorPreset>Extended</EmissiveColorPreset>
      <AllowSelfPulling>true</AllowSelfPulling>
    </Definition>

    <!-- ============================= -->
    <!-- T1 METAL EXTRUDER             -->
    <!-- Forms rods, tubes, and pipes  -->
    <!-- ============================= -->

    <Definition xsi:type="MyObjectBuilder_AssemblerDefinition">
      <Id>
        <TypeId>Assembler</TypeId>
        <SubtypeId>T1_MetalExtruder</SubtypeId>
      </Id>
      <DisplayName>Metal Extruder</DisplayName>
      <Icon>..\2344068716\Icons\Extruder.dds</Icon>
      <Icon>Icons\t1.dds</Icon>
      <Description>A basic extruder for forming iron ingots into rods, tubes, and pipes.
	  
Power Usage: 0.5 MW</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="2" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>..\2344068716\Models\Extruder.mwm</Model>
      <Components>
        <Component Subtype="IronPlate" Count="60" />
        <Component Subtype="IronRod" Count="30" />
        <Component Subtype="IronBolt" Count="40" />
        <Component Subtype="IronTube" Count="15" />
        <Component Subtype="SimpleBearing" Count="6" />
        <Component Subtype="IronFrameS" Count="4" />
        <Component Subtype="IronPlate" Count="20" />
      </Components>
      <CriticalComponent Subtype="SimpleBearing" Index="0" />
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.50" File="..\2344068716\Models\Construct\Generic2x2Construct1.mwm" />
        <Model BuildPercentUpperBound="1.00" File="..\2344068716\Models\Construct\Generic2x2Construct2.mwm" />
      </BuildProgressModels>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>50</BuildTimeSeconds>
      <ResourceSinkGroup>Factory</ResourceSinkGroup>
      <InventoryMaxVolume>4</InventoryMaxVolume>
      <InventorySize>
        <X>1</X>
        <Y>1</Y>
        <Z>1</Z>
      </InventorySize>
      <StandbyPowerConsumption>0.001</StandbyPowerConsumption>
      <OperationalPowerConsumption>0.5</OperationalPowerConsumption>
      <BlueprintClasses>
        <Class>T1Extruder</Class>
      </BlueprintClasses>
      <AssemblySpeed>0.75</AssemblySpeed>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <PrimarySound>BlockAssembler</PrimarySound>
      <ActionSound>BlockAssemblerProcess</ActionSound>
      <DestroyEffect>Explosion_Missile</DestroyEffect>
      <DestroySound>WepSmallMissileExpl</DestroySound>
      <PCU>40</PCU>
      <IsAirTight>true</IsAirTight>
      <EmissiveColorPreset>Extended</EmissiveColorPreset>
      <AllowSelfPulling>true</AllowSelfPulling>
    </Definition>

    <!-- ============================= -->
    <!-- T1 FABRICATOR                 -->
    <!-- Assembles composite parts     -->
    <!-- ============================= -->

    <Definition xsi:type="MyObjectBuilder_AssemblerDefinition">
      <Id>
        <TypeId>Assembler</TypeId>
        <SubtypeId>T1_Fabricator</SubtypeId>
      </Id>
      <DisplayName>Fabricator</DisplayName>
      <Icon>Textures\GUI\Icons\Cubes\basicAssembler.dds</Icon>
      <Icon>Icons\t1.dds</Icon>
      <Description>A basic fabricator for assembling composite parts from simple components.
	  
Power Usage: 0.5 MW</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Large\BasicAssembler.mwm</Model>
      <Components>
        <Component Subtype="IronPlate" Count="40" />
        <Component Subtype="IronRod" Count="20" />
        <Component Subtype="IronBolt" Count="30" />
        <Component Subtype="IronTube" Count="10" />
        <Component Subtype="IronPipe" Count="5" />
        <Component Subtype="SimpleBearing" Count="4" />
        <Component Subtype="IronFrameS" Count="2" />
        <Component Subtype="IronPlate" Count="10" />
      </Components>
      <CriticalComponent Subtype="SimpleBearing" Index="0" />
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\BasicAssembler_Construction1.mwm" />
        <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\BasicAssembler_Construction2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\BasicAssembler_Construction3.mwm" />
      </BuildProgressModels>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>45</BuildTimeSeconds>
      <ResourceSinkGroup>Factory</ResourceSinkGroup>
      <InventoryMaxVolume>4</InventoryMaxVolume>
      <InventorySize>
        <X>1</X>
        <Y>1</Y>
        <Z>1</Z>
      </InventorySize>
      <StandbyPowerConsumption>0.001</StandbyPowerConsumption>
      <OperationalPowerConsumption>0.5</OperationalPowerConsumption>
      <BlueprintClasses>
        <Class>T1Fabricator</Class>
      </BlueprintClasses>
      <AssemblySpeed>0.75</AssemblySpeed>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <PrimarySound>BlockAssembler</PrimarySound>
      <ActionSound>BlockAssemblerProcess</ActionSound>
      <DestroyEffect>Explosion_Missile</DestroyEffect>
      <DestroySound>WepSmallMissileExpl</DestroySound>
      <PCU>40</PCU>
      <IsAirTight>true</IsAirTight>
      <EmissiveColorPreset>Extended</EmissiveColorPreset>
      <AllowSelfPulling>true</AllowSelfPulling>
    </Definition>

    <!-- ============================= -->
    <!-- T1 ASSEMBLING BENCH           -->
    <!-- Manual crafting, very slow    -->
    <!-- ============================= -->

    <Definition xsi:type="MyObjectBuilder_AssemblerDefinition">
      <Id>
        <TypeId>Assembler</TypeId>
        <SubtypeId>T1_AssemblingBench</SubtypeId>
      </Id>
      <DisplayName>Assembling Bench</DisplayName>
      <Icon>..\2344068716\Icons\AssemblingBench.dds</Icon>
      <Description>A simple workbench for manually assembling basic components. Very slow, but can craft all T1 items.
	  
Power Usage: 0.1 MW</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>..\2344068716\Models\AssemblingBench.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="20" />
        <Component Subtype="LargeTube" Count="10" />
        <Component Subtype="Construction" Count="15" />
      </Components>
      <CriticalComponent Subtype="Construction" Index="0" />
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" />
      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="..\2344068716\Models\Construct\AssemblingBenchConstruct1.mwm" />
        <Model BuildPercentUpperBound="0.66" File="..\2344068716\Models\Construct\AssemblingBenchConstruct2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="..\2344068716\Models\Construct\AssemblingBenchConstruct3.mwm" />
      </BuildProgressModels>
      <BlockPairName>T1AssemblingBench</BlockPairName>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>30</BuildTimeSeconds>
      <ResourceSinkGroup>Factory</ResourceSinkGroup>
      <InventoryMaxVolume>2</InventoryMaxVolume>
      <InventorySize>
        <X>1</X>
        <Y>1</Y>
        <Z>1</Z>
      </InventorySize>
      <StandbyPowerConsumption>0.0</StandbyPowerConsumption>
      <OperationalPowerConsumption>0.0</OperationalPowerConsumption>
      <BlueprintClasses>
        <Class>T1AssemblingBench</Class>
      </BlueprintClasses>
      <AssemblySpeed>0.25</AssemblySpeed>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <PrimarySound>BlockAssembler</PrimarySound>
      <ActionSound>BlockAssemblerProcess</ActionSound>
      <DestroyEffect>Explosion_Missile</DestroyEffect>
      <DestroySound>WepSmallMissileExpl</DestroySound>
      <PCU>40</PCU>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <IsAirTight>true</IsAirTight>
      <TieredUpdateTimes>
        <unsignedInt>60</unsignedInt>
        <unsignedInt>120</unsignedInt>
        <unsignedInt>240</unsignedInt>
      </TieredUpdateTimes>
      <AllowSelfPulling>false</AllowSelfPulling>
    </Definition>

  </CubeBlocks>
</Definitions>
