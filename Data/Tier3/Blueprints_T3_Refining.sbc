<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Blueprints>

    <!-- ============================= -->
    <!-- TIER 3 ORE REFINING           -->
    <!-- Impure Ores: 25% Efficiency   -->
    <!-- Normal Ores: 60% Efficiency   -->
    <!-- Pure Ores: 80% Efficiency     -->
    <!-- ============================= -->

    <!-- ========== IMPURE ORES (25%) ========== -->

    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>T3_GoldOreImpureToIngot</SubtypeId>
      </Id>
      <DisplayName>Gold Ingot (Impure)</DisplayName>
      <Icon>Textures\GUI\Icons\ingot\gold_ingot.dds</Icon>
      <Prerequisites>
        <Item Amount="1000" TypeId="Ore" SubtypeId="GoldOreImpure" />
      </Prerequisites>
      <Result Amount="250" TypeId="Ingot" SubtypeId="Gold" />
      <BaseProductionTimeInSeconds>3000</BaseProductionTimeInSeconds>
      <IsPrimary>true</IsPrimary>
    </Blueprint>

    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>T3_PlatinumOreImpureToIngot</SubtypeId>
